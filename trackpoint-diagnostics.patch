+// ---- TrackPoint PS/2 link diagnostics -----------------------------------------------
+// TP_STAT types the PS/2 frame counters into whatever text field has focus, so the link
+// can be measured without a console build or any extra tooling. Bind these two in Vial as
+// "Custom 0" / "Custom 1", focus a text editor, tap TP_ZERO to clear, use the stick for a
+// while, then tap TP_STAT to print. See tp_stats_send() in pointing.c for how to read the
+// numbers.
+//
+// NOTE: process_record_user runs on the USB MASTER only, so plug the half that CARRIES
+// the TrackPoint into USB when sampling — otherwise you are reading the counters of the
+// half that has no stick (which will simply show NONE with everything at zero).
+#ifdef POINTING_DEVICE_ENABLE
+extern void tp_stats_send(void);
+extern void tp_stats_reset(void);
+extern void tp_raw_send(void);
+
+enum custom_keycodes {
+    TP_STAT = QK_KB_0, // Vial "Custom 0" — print counters as keystrokes
+    TP_ZERO,           // Vial "Custom 1" — reset counters to zero
+    TP_RAW,            // Vial "Custom 2" — print the last raw packets
+};
+
+bool process_record_user(uint16_t keycode, keyrecord_t *record) {
+    if (!record->event.pressed) {
+        return true;
+    }
+    switch (keycode) {
+        case TP_STAT:
+            tp_stats_send();
+            return false;
+        case TP_ZERO:
+            tp_stats_reset();
+            return false;
+        case TP_RAW:
+            tp_raw_send();
+            return false;
+    }
+    return true;
+}
+#endif // POINTING_DEVICE_ENABLE
 
