-// ---- PS/2 packet decoding ------------------------------------------------------------
-// The PIO driver signals a bad frame (start / parity / stop) by setting ps2_error and
-// returning 0x00 -- at the return value a corrupted frame is indistinguishable from a
-// genuine 0x00 data byte. Ignoring ps2_error therefore corrupts the stream in two ways:
-// a rejected frame landing mid-packet is consumed as a real X or Y delta, and one landing
-// at packet-start returns 0x00, fails the header test and is silently skipped -- which
-// DROPS A BYTE, because the device really did transmit one in that slot. Every following
-// byte is then read one position early and the packet phase stays shifted. So we check
-// ps2_error on every read and abandon the packet when a frame is bad.
+// ---- PS/2 link health + payload counters --------------------------------------------
+// MEASURED 2026-08-27 on the misbehaving stick: ok=1050 err=0 rsy=0 ovf=0 stl=0 pkt=350.
+// 1050 == 350*3 exactly, and not one frame failed the driver's start/parity/stop check --
+// so the PS/2 link is byte-perfect and has never lost sync. That rules out the physical
+// layer (supply, pull-ups, solder joints) AND any framing/desync bug in this decoder as
+// the cause of the erratic cursor. Whatever is wrong is in the CONTENT the module sends,
+// or in what happens to it downstream.
 //
-// If the pointer ever misbehaves again, trackpoint-diagnostics.md documents how to
-// re-add the instrumentation that measures this (frame counters + raw packet log) and
-// how to read the numbers. Diagnosed once on 2026-08-27; see that file for the case
-// record.
+// Kept in place because it is cheap and it is what proves the link stays healthy. The
+// payload counters below were added next to answer the follow-up question: what are the
+// actual flags / x / y values?
+typedef struct {
+    uint16_t ok;     // frames that passed the driver's start/parity/stop check
+    uint16_t err;    // frames the driver REJECTED -- physical layer health lives here
+    uint16_t resync; // bytes discarded while hunting for a packet boundary
+    uint16_t ovf;    // headers dropped because the X/Y overflow bits were set
+    uint16_t stale;  // partial packets dropped by the inter-packet idle timeout
+    uint16_t pkts;   // packets decoded successfully
+    // ---- payload observation ----
+    int16_t xmin, xmax; // extremes of the raw per-packet X delta
+    int16_t ymin, ymax; // extremes of the raw per-packet Y delta
+    uint8_t btnseen;    // OR of every button bit ever reported (a stuck button drags!)
+    uint8_t maxburst;   // most packets consumed in a SINGLE poll -- they are summed, so
+                        // a large burst multiplies into one huge cursor jump
+} tp_stats_t;
+
+static tp_stats_t tp_stats = {.xmin = INT16_MAX, .xmax = INT16_MIN, .ymin = INT16_MAX, .ymax = INT16_MIN};
+
+// Ring of the most recent raw packets, so the actual bytes can be inspected instead of
+// guessed at. This is the difference between "the link is fine" and "the module is
+// reporting sane numbers" -- the counters above only prove the former.
+#define TP_RAW_LOG 8
+static struct {
+    uint8_t f;
+    int16_t x, y;
+} tp_raw[TP_RAW_LOG];
+static uint8_t tp_raw_head  = 0;
+static uint8_t tp_raw_count = 0;
 
 // A partial packet is NORMAL: at a 10 ms poll interval the module's 3-byte burst is often
 // split across two polls, so the timeout must comfortably exceed one poll period. It is
@@ -227,12 +252,14 @@
