+// ---- Link diagnostics readout -------------------------------------------------------
+// Types the counters as keystrokes, so no console build or extra tooling is needed --
+// focus any text field and press the key bound to Vial's "Custom 0" / "Custom 2".
+//
+// IMPORTANT: this runs on the USB MASTER. To read the TrackPoint half's counters, plug
+// THAT half into USB (the other half may stay disconnected).
+//
+// Link health (already answered: the link is clean):
+//   err large next to ok  -> physical layer failing (supply / pull-ups / solder joint)
+//   err ~0 but rsy large  -> bytes intact but packet phase wrong (a framing bug)
+//   ok ~0                 -> module silent: unpowered, or reporting never re-enabled
+//
+// Payload (what we are looking at now):
+//   pkt rising while the stick is UNTOUCHED -> the module reports motion on its own:
+//        a failed strain gauge / drift compensation, i.e. a hardware fault in the module
+//   x or y pinned at +/-255ish -> the module is saturating on that axis
+//   btn non-zero when nothing is pressed -> a stuck button; motion then becomes a DRAG,
+//        which on screen looks like wild flickering selection rather than a moving cursor
+//   brst large -> many packets summed into one poll, multiplying into a single big jump
+static void tp_put_str(char *dst, uint8_t *pos, const char *s) {
+    while (*s) {
+        dst[(*pos)++] = *s++;
+    }
+}
+
+static void tp_put_u16(char *dst, uint8_t *pos, const char *label, uint16_t v) {
+    tp_put_str(dst, pos, label);
+    char    tmp[6];
+    uint8_t n = 0;
+    do {
+        tmp[n++] = (char)('0' + v % 10);
+        v /= 10;
+    } while (v);
+    while (n) {
+        dst[(*pos)++] = tmp[--n];
+    }
+    dst[(*pos)++] = ' ';
+}
+
+static void tp_put_i16(char *dst, uint8_t *pos, const char *label, int16_t v) {
+    tp_put_str(dst, pos, label);
+    int32_t n = v;
+    if (n < 0) {
+        dst[(*pos)++] = '-';
+        n             = -n;
+    } else {
+        dst[(*pos)++] = '+';
+    }
+    char    tmp[8];
+    uint8_t k = 0;
+    do {
+        tmp[k++] = (char)('0' + n % 10);
+        n /= 10;
+    } while (n);
+    while (k) {
+        dst[(*pos)++] = tmp[--k];
+    }
+}
+
+static void tp_put_hex8(char *dst, uint8_t *pos, uint8_t v) {
+    static const char h[] = "0123456789ABCDEF";
+    dst[(*pos)++]         = h[v >> 4];
+    dst[(*pos)++]         = h[v & 0x0F];
+}
+
+void tp_stats_send(void) {
+    char    buf[160];
+    uint8_t p = 0;
+
+    tp_put_str(buf, &p, active_module == MODULE_TRACKPOINT ? "TP " : (active_module == MODULE_TPS43 ? "PAD " : "NONE "));
+    tp_put_u16(buf, &p, "ok=", tp_stats.ok);
+    tp_put_u16(buf, &p, "err=", tp_stats.err);
+    tp_put_u16(buf, &p, "rsy=", tp_stats.resync);
+    tp_put_u16(buf, &p, "ovf=", tp_stats.ovf);
+    tp_put_u16(buf, &p, "stl=", tp_stats.stale);
+    tp_put_u16(buf, &p, "pkt=", tp_stats.pkts);
+    if (tp_stats.pkts) {
+        tp_put_i16(buf, &p, "x=", tp_stats.xmin);
+        tp_put_i16(buf, &p, "..", tp_stats.xmax);
+        buf[p++] = ' ';
+        tp_put_i16(buf, &p, "y=", tp_stats.ymin);
+        tp_put_i16(buf, &p, "..", tp_stats.ymax);
+        buf[p++] = ' ';
+    }
+    tp_put_str(buf, &p, "btn=");
+    tp_put_hex8(buf, &p, tp_stats.btnseen);
+    buf[p++] = ' ';
+    tp_put_u16(buf, &p, "brst=", tp_stats.maxburst);
+    buf[p] = '\0';
+
+    send_string(buf);
+}
+
+// Types the last few raw packets, oldest first: "f08 x+3 y-2 | f18 x-128 y+0 | ..."
+// f is byte0 in hex (bit3 always set; bits 0-2 buttons; bit4/5 X/Y sign; bit6/7 overflow).
+void tp_raw_send(void) {
+    char    buf[200];
+    uint8_t p = 0;
+
+    if (tp_raw_count == 0) {
+        send_string("TP raw: none");
+        return;
+    }
+
+    // Walk from the oldest retained entry to the newest.
+    uint8_t start = (uint8_t)((tp_raw_head + TP_RAW_LOG - tp_raw_count) % TP_RAW_LOG);
+    for (uint8_t n = 0; n < tp_raw_count; n++) {
+        uint8_t idx = (uint8_t)((start + n) % TP_RAW_LOG);
+        if (n) {
+            tp_put_str(buf, &p, " | ");
+        }
+        buf[p++] = 'f';
+        tp_put_hex8(buf, &p, tp_raw[idx].f);
+        tp_put_i16(buf, &p, " x", tp_raw[idx].x);
+        tp_put_i16(buf, &p, " y", tp_raw[idx].y);
+    }
+    buf[p] = '\0';
+
+    send_string(buf);
+}
+
+void tp_stats_reset(void) {
+    memset(&tp_stats, 0, sizeof(tp_stats));
+    tp_stats.xmin = INT16_MAX;
+    tp_stats.xmax = INT16_MIN;
+    tp_stats.ymin = INT16_MAX;
+    tp_stats.ymax = INT16_MIN;
+    tp_raw_head   = 0;
+    tp_raw_count  = 0;
+}
